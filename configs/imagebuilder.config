# ImageBuilder build settings.
# Only merged by .github/workflows/build-imagebuilder.yml, so that the seed
# build also produces a ready-to-use ImageBuilder for airoha/an7581.
#
#   CONFIG_IB            -> build the ImageBuilder tarball as part of `make`
#   CONFIG_IB_STANDALONE -> bundle every package built here into the tarball,
#                           so later `make image PACKAGES=...` runs offline and
#                           needs no remote package repository.
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
