# Packages requested for the 3-device (hg5585f-ct / zn504xg-d / zn515xg-d) build.
# Merged on top of configs/an7581.config + configs/release.config via scripts/kconfig.pl.

# ---------------------------------------------------------------------------
# Firmware package source (软件源) -> NJU mirror
# IMAGEOPT/VERSIONOPT must be enabled, otherwise the VERSION_* prompts are
# hidden and defconfig drops the values below, making include/version.mk fall
# back to downloads.immortalwrt.org/snapshots. The build workflows also patch
# that fallback as a belt-and-braces measure.
# DIST/FILENAMES keep their previous values so image names stay unchanged.
# ---------------------------------------------------------------------------
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="PonWrt"
CONFIG_VERSION_REPO="https://mirror.nju.edu.cn/immortalwrt/snapshots"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set

# Base utilities
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y

# ttyd
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# filemanager
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y

# rtp2httpd (IPTV: rtp/multicast -> http)
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# honk (eBPF transparent proxy, from the QiuSimons/luci-app-honk feed)
# CONFIG_PACKAGE_honk=y
# CONFIG_PACKAGE_luci-app-honk=y
# CONFIG_PACKAGE_luci-i18n-honk-zh-cn=y
# honk-core is CO-RE eBPF and needs BTF in the kernel (vmlinux-btf is not in
# the immortalwrt feeds), so enable kernel BTF; this selects the DWARVES tool.
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# Kernel modules needed by honk at runtime (honk itself is NOT built).
# These let you install honk later without rebuilding the kernel/firmware.
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y

# frpc
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y

# EasyTier (third-party: EasyTier/luci-app-easytier)
# CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# IPTV multicast fix (from pzzfl/BrightSpeed-XG2010G)
CONFIG_PACKAGE_iptv-fix=y
